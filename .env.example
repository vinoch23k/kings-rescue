PORT=3000
APP_ORIGIN=http://localhost:3000
# mongo is required by default. Run npm run dev:local only after choosing demo mode below.
STORAGE_MODE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=kings_rescue
FISH_API_URL=https://marcconrad.com/uob/fish/api.php
FISH_IMAGE_HOSTS=www.sanfoh.com,sanfoh.com,marcconrad.com,www.marcconrad.com
FISH_TIMEOUT_MS=6000
# Set true to demonstrate offline puzzles without waiting for network timeouts.
OFFLINE_PUZZLES=false
NODE_ENV=development
